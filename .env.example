# === Required for PDF remediation + Ask-a-Question ===
# Google AI Studio API key — covers both generateContent (gemini-2.5-flash-lite)
# AND the File Search API. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# === Optional: protect the backend with a simple API key ===
# Leave blank to allow unauthenticated requests (fine for the public demo).
# When set, clients must send X-API-Key: <value> on /api/* routes.
APP_API_KEY=

# === Where the viewer iframe is served from ===
# Must match the origin that the host page loads docbox.js from.
# Local dev: http://localhost:8000 — production: https://access.project-remedy.com
PUBLIC_ORIGIN=http://localhost:8000

# === LiveKit + Gemini Live voice agent (Phase 3 — leave blank to disable) ===
# All three LIVEKIT_* vars must be set for /api/live-token to mint a real token;
# otherwise the Assist panel renders disabled with a "LiveKit not configured" hint.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Gemini Live native-audio model used by the LiveKit agent worker.
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# === Storage ===
DATA_DIR=./data
# 50 MiB cap on fetched PDFs.
MAX_PDF_BYTES=52428800

# === Model overrides (rarely needed) ===
GEMINI_REMEDIATION_MODEL=gemini-2.5-flash-lite
GEMINI_ASK_MODEL=gemini-2.5-flash

# === Structured render workflow ===
# Enables deterministic parse -> layout plan -> WCAG HTML rendering before
# falling back to full LLM remediation.
STRUCTURED_RENDER_V2_ENABLED=true
STRUCTURED_RENDER_V2_PDF_BACKEND=native

# Optional server-side LlamaParse parser backend. Required only when
# STRUCTURED_RENDER_V2_PDF_BACKEND=llamaparse. Keep this server-side.
LLAMA_CLOUD_API_KEY=
LLAMAPARSE_BASE_URL=
LLAMAPARSE_TIER=cost_effective
LLAMAPARSE_VERSION=latest
LLAMAPARSE_MAX_PAGES=
LLAMAPARSE_TARGET_PAGES=
LLAMAPARSE_COST_OPTIMIZER=false
LLAMAPARSE_DISABLE_CACHE=false
LLAMAPARSE_DO_NOT_CACHE=false
LLAMAPARSE_TIMEOUT_S=300
LLAMAPARSE_OCR_LANGUAGES=en

# Optional bounded layout critique pass. It may move blocks between predefined
# layout containers, but it cannot rewrite text or HTML.
LAYOUT_AGENT_ENABLED=false
LAYOUT_AGENT_MODEL=kimi-k2.6:cloud
LAYOUT_AGENT_APPLY_TO_FORMATS=pdf
