# Copy to .env.production on the VPS and fill in real values.
# Never commit .env.production.

# Public HTTPS hostname handled by Caddy. No scheme here.
PUBLIC_HOST=access.example.com

# Must match the URL where docbox.js and the viewer are served.
PUBLIC_ORIGIN=https://access.example.com

# Caddy request body limit. Keep aligned with MAX_PDF_BYTES.
MAX_REQUEST_BODY_SIZE=60MB

# Model/provider configuration.
# Recommended production mode for the current app:
# - Ollama-compatible model for translation and fallback remediation.
# - Google key for File Search-backed Ask panel.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_API_KEY=replace-with-ollama-key
OLLAMA_PLAN_MODEL=kimi-k2.5:cloud
OLLAMA_REMEDIATION_MODEL=kimi-k2.5:cloud
OLLAMA_REASONING_LEVEL=low

GOOGLE_API_KEY=replace-with-google-ai-studio-key
GEMINI_REMEDIATION_MODEL=gemini-2.5-flash-lite
GEMINI_ASK_MODEL=gemini-2.5-flash
GEMINI_CALL_TIMEOUT=180

# Structured parser/rendering.
STRUCTURED_RENDER_V2_ENABLED=true
STRUCTURED_RENDER_V2_PDF_BACKEND=llamaparse
LLAMA_CLOUD_API_KEY=replace-with-llamaparse-key
LLAMAPARSE_BASE_URL=
LLAMAPARSE_TIER=cost_effective
LLAMAPARSE_VERSION=latest
LLAMAPARSE_MAX_PAGES=
LLAMAPARSE_TARGET_PAGES=
LLAMAPARSE_COST_OPTIMIZER=false
LLAMAPARSE_DISABLE_CACHE=false
LLAMAPARSE_DO_NOT_CACHE=false
LLAMAPARSE_TIMEOUT_S=300
LLAMAPARSE_OCR_LANGUAGES=en

# Public viewer mode:
# Leave APP_API_KEY blank. The browser viewer cannot keep a backend API key secret.
# Use Caddy/private network auth for private deployments.
APP_API_KEY=

# App-side per-IP fixed-window limits. Caddy forwards the real client IP.
TRUST_PROXY_HEADERS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_INGEST_PER_MINUTE=12
RATE_LIMIT_TRANSLATE_PER_MINUTE=20
RATE_LIMIT_ASK_PER_MINUTE=60

# Storage inside the container. docker-compose.prod.yml mounts ./data-prod here.
DATA_DIR=/app/data
MAX_PDF_BYTES=52428800

# Optional Caddy private staging auth. See Caddyfile comments.
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH=

# Optional LiveKit. Leave blank to disable Assist.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Keep layout critique off unless you intentionally want the extra model cost.
LAYOUT_AGENT_ENABLED=false
LAYOUT_AGENT_MODEL=kimi-k2.6:cloud
LAYOUT_AGENT_APPLY_TO_FORMATS=pdf
